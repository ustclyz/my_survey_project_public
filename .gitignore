# ---------------------------------------------------------------------------
# Python 科研项目标准 .gitignore
# GOSIM 巡天智能体项目
# ---------------------------------------------------------------------------

# --- Python 编译缓存 ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Python 虚拟环境 ---
.venv/
venv/
ENV/
env/
.python-version
pip-log.txt
pip-delete-this-directory.txt

# --- 单元测试 / 覆盖率 ---
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
htmlcov/

# --- Jupyter Notebook ---
.ipynb_checkpoints/

# --- 类型检查 / 静态分析缓存 ---
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.ruff_cache/

# --- 日志与临时文件 ---
*.log
*.tmp
*.temp
*.bak
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini

# --- 本地配置 / 环境变量 / 密钥文件 (安全) ---
.env
.env.*
!.env.example
*.local
*.local.json
config.local.*
secrets.*
*.pem
*.key
*.p12
credentials.json
*token*.json

# --- 数据产物 / 中间结果 (按需保留) ---
/data/
/outputs/
/results/
*.h5
*.hdf5
*.parquet
*.feather

# --- IDE / 编辑器 ---
.idea/
.vscode/
*.code-workspace
*.sublime-project
*.sublime-workspace

# --- 注意: 本项目不忽略 reports/ 下的交付报告 (作为产物保留) ---

# ===========================================================================
# 增强补充 (GOSIM 巡天黑客松 专项)
# ===========================================================================

# --- LLM API 密钥 / 凭据 (黑客松硬性要求: 密钥绝不入仓) ---
api_key*
apikey*
api_keys.json
.credential*
*.secret
.secrets/
openai_key*
anthropic_key*
*_API_KEY*
*api_key*.json
config.ini            # 可能包含密钥的本地配置
settings.local.json

# --- 项目工作日志 (Opencode 操作记录, 不随仓库提交) ---
opencode_worklog.txt
*_worklog.txt

# --- 科学计算 / 数据缓存产物 ---
*.npy
*.npz
*.pkl
*.pickle
*.mat
*.fits
*.fits.gz

# --- LLM 推理缓存 / 中间规划输出 ---
*.cache.json
*_cache/
cache/
*.plans.json

# --- 压缩包 (任务卡原始zip保留在外部资源目录, 不提交) ---
*.zip
*.tar
*.gz
*.7z
*.rar
