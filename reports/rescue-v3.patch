+    for day in range(2, 7):
+        text = f'【立希】工程组通知：10/{day} 21:30 动导星相机。到点报修。'
+        feed(s, text)
+        when = utc(f'2026-10-{day+1:02}T01:30:00')
+        assert s.due(when)
+        s.acknowledge(when)
+        feed(s, text)
+        assert not s.due(when)
